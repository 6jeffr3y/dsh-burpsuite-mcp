{
  "name": "dsh-plugin-burpsuite-mcp",
  "version": "0.3.1",
  "type": "module",
  "main": "./lib/index.js",
  "description": "DeepSeek Harness bundle for the BurpSuite MCP Bridge",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "6jeffr3y",
    "url": "https://github.com/6jeffr3y"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6jeffr3y/dsh-burpsuite-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/6jeffr3y/dsh-burpsuite-mcp/issues"
  },
  "homepage": "https://github.com/6jeffr3y/dsh-burpsuite-mcp#readme",
  "keywords": [
    "dsh-plugin",
    "mcp",
    "burpsuite"
  ],
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "requirements.txt",
    "server.py"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --test tests/*.test.js && python3 -m unittest discover -s tests -p 'test_*.py'",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  }
}
